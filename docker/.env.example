# Host-side published ports for the API stack (docker compose variable
# substitution).
#
# This file is OPTIONAL. It is only needed for LOCAL OVERRIDES on a machine
# where the default host ports are already taken. The stack runs fine with the
# defaults below without this file.
#
# IMPORTANT: this file (docker/.env) is read by Docker Compose for variable
# substitution in docker-compose.yml. It is a DIFFERENT file from
# src/api/.env, which is the application configuration loaded by the PHP app
# at runtime (database credentials, APP_URL, ALLOWED_ORIGINS, ...).
#
# To use: copy this file to docker/.env and adjust. docker/.env must NOT be
# committed (it is git-ignored).
#
# The values must be host ports that are free on your machine. Changing them
# only changes where the services are reachable from the HOST; containers keep
# talking to each other by service name and container port (db:3306,
# nginx 80/443, phpMyAdmin 80).

# API nginx HTTP  (container port 80)
API_HTTP_PORT=3011

# API nginx HTTPS (container port 443)
API_HTTPS_PORT=3444

# MySQL           (container port 3306)
MYSQL_PORT=3308

# phpMyAdmin      (container port 80)
PHPMYADMIN_PORT=3016
