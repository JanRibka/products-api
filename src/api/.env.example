# Application
APP_NAME="Products API"
APP_VERSION="0.1.0"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3011

# CORS (comma separated).
# Only relevant for DIRECT browser access to the API from another origin.
# With the UI's nginx reverse proxy the browser talks only to the UI origin
# (http://localhost:8080) and proxies /api/ server-to-server, so CORS is not
# exercised at all in that topology.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Database
# Inside Docker the database is db:3306; host-side mapped ports are only for
# tools running on the host.
DB_DRIVER=pdo_mysql
DB_HOST=db
DB_PORT=3306
DB_NAME=products-api
DB_USER=productsuser
DB_PASS=productspassword

# Test database (integration tests)
TEST_DB_NAME=products-api-test
