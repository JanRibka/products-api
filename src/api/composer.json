{
  "name": "krytypodmotor/products-api",
  "description": "API for storing, listing and editing products",
  "version": "0.1.0",
  "license": "proprietary",
  "authors": [
    {
      "name": "Jan Ribka",
      "email": "ribkaj@seznam.cz"
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Test\\": "test/"
    }
  },
  "config": {
    "platform": {
      "php": "8.5.0"
    },
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "test": [
      "@test:unit",
      "@test:integration"
    ],
    "test:unit": "phpunit --colors=always --testsuite=Unit --testdox",
    "test:integration": "phpunit --colors=always --testsuite=Integration --testdox",
    "lint:check": "vendor/bin/phpcs --standard=phpcs.xml",
    "lint:summary": "vendor/bin/phpcs --standard=phpcs.xml --report=summary",
    "lint:fix": "vendor/bin/php-cs-fixer fix",
    "analyze": "vendor/bin/phpstan analyse app --ansi --memory-limit 512M"
  },
  "require": {
    "doctrine/dbal": "^4.4",
    "doctrine/migrations": "^3.9",
    "doctrine/orm": "^3.6",
    "doctrine/data-fixtures": "^2.2",
    "php-di/php-di": "^7.1",
    "phpstan/phpstan": "^2.1",
    "slim/psr7": "^1.8",
    "slim/slim": "^4.15",
    "symfony/cache": "^7.0 || ^8.0",
    "symfony/console": "^8.0",
    "vlucas/phpdotenv": "^5.6",
    "vlucas/valitron": "^1.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpunit/phpunit": "^12.5",
    "squizlabs/php_codesniffer": "*"
  }
}
